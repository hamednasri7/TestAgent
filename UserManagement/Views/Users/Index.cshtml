@model IEnumerable<UserManagement.Models.User>
@{
    ViewData["Title"] = "لیست کاربران";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>لیست کاربران</h1>
    <a asp-action="Create" class="btn btn-primary">افزودن کاربر</a>
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success">@statusMessage</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">هیچ کاربری ثبت نشده است.</div>
}
else
{
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>نام</th>
                <th>نام خانوادگی</th>
                <th>سن</th>
                <th>موبایل</th>
                <th class="text-center">عملیات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.FirstName</td>
                    <td>@user.LastName</td>
                    <td>@user.Age</td>
                    <td>@user.Mobile</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">ویرایش</a>
                        <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger">حذف</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
