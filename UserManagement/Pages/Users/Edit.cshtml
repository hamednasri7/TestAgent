@page
@model UserManagement.Pages.Users.EditModel
@{
    ViewData["Title"] = "ویرایش کاربر";
}

<h1>ویرایش کاربر</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Input.Id" />

            <div class="mb-3">
                <label asp-for="Input.FirstName" class="form-label"></label>
                <input asp-for="Input.FirstName" class="form-control" autocomplete="off" />
                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.LastName" class="form-label"></label>
                <input asp-for="Input.LastName" class="form-control" autocomplete="off" />
                <span asp-validation-for="Input.LastName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Age" class="form-label"></label>
                <input asp-for="Input.Age" class="form-control" autocomplete="off" inputmode="numeric" />
                <span asp-validation-for="Input.Age" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Mobile" class="form-label"></label>
                <input asp-for="Input.Mobile" class="form-control" autocomplete="off" inputmode="numeric" maxlength="11" dir="ltr" />
                <span asp-validation-for="Input.Mobile" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">ذخیره</button>
            <a asp-page="Index" class="btn btn-secondary">انصراف</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
